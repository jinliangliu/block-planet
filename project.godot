; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Block Planet"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

Events="*res://scripts/core/events.gd"
Sfx="*res://scripts/core/sfx.gd"
GameState="*res://scripts/core/game_state.gd"
Profile="*res://scripts/core/profile_manager.gd"
Progress="*res://scripts/systems/progress_manager.gd"
BestiaryData="*res://scripts/systems/bestiary_data.gd"
FishingSystem="*res://scripts/systems/fishing_system.gd"
RaceSystem="*res://scripts/systems/race_system.gd"
BoatSystem="*res://scripts/systems/boat_system.gd"

[debug]

gdscript/warnings/enable_all_warnings=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="mobile"
